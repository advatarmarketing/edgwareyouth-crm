# Copy to .env.local and fill in from your Supabase project.
# .env.local is gitignored and must never be committed.

# Supabase -> Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase -> Project Settings -> API Keys -> anon / public
# Safe in the browser. RLS is what protects the data, not this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase -> Project Settings -> API Keys -> service_role
# SECRET. Bypasses every RLS policy. Server-side and scripts only —
# never prefix it with NEXT_PUBLIC_ and never paste it into a client
# component.
SUPABASE_SERVICE_ROLE_KEY=

# Where the app is reachable, used to build links inside emails.
# http://localhost:3000 locally; the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protects /api/cron/reminders, which writes notification rows and is
# otherwise an unauthenticated endpoint anybody could spam. Any long
# random string; generate one with:  openssl rand -hex 32
CRON_SECRET=

# Email delivery. The bell works without these; only the emails don't.
# EMAIL_FROM="Edgware Youth CRM <crm@edgwareyouth.org>"
# RESEND_API_KEY=
